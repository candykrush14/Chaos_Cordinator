rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----- helpers -------------------------------------------------------------
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isStr(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    function getUserRole(uid) {
      return exists(/databases/$(database)/documents/roles/$(uid))
        ? get(/databases/$(database)/documents/roles/$(uid)).data.role
        : 'user';
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'shreyasrivastava0407@gmail.com' ||
        getUserRole(request.auth.uid) == 'admin'
      );
    }

    function isValidLocation(loc) {
      return loc is map
        && loc.lat is number && loc.lat >= -90 && loc.lat <= 90
        && loc.lng is number && loc.lng >= -180 && loc.lng <= 180
        && isStr(loc.name, 300)
        && (!('address' in loc) || loc.address == null || loc.address is string);
    }

    // Shape / size validation for a reflection ("interaction") document.
    // The 1 MiB per-document Firestore limit is the hard cap; these checks stop
    // an authenticated client from writing junk or oversized data into its own
    // space and running up storage/read cost.
    function isValidInteraction(d, userId) {
      return d.userId == userId
        && isStr(d.id, 128)
        && isStr(d.title, 300)
        && isStr(d.createdAt, 40)
        && isStr(d.updatedAt, 40)
        && d.mode in ['reflection', 'summary', 'brainstorm']
        && d.messages is list
        && d.messages.size() <= 400
        && (!('category' in d) || d.category == null
            || d.category in ['personal', 'work', 'ideas', 'gratitude', 'mindfulness'])
        && (!('location' in d) || d.location == null || isValidLocation(d.location))
        && (!('summary' in d) || d.summary == null || d.summary is string)
        && (!('tags' in d) || d.tags == null || d.tags is list)
        && (!('isPinned' in d) || d.isPinned == null || d.isPinned is bool);
    }

    function isValidShare(d) {
      return d.ownerId == request.auth.uid
        && isStr(d.id, 128)
        && isStr(d.reflectionId, 128)
        && isStr(d.reflectionTitle, 300)
        && isStr(d.targetEmail, 320)
        && d.permission in ['viewer', 'editor']
        && isStr(d.createdAt, 40)
        && isStr(d.updatedAt, 40);
    }

    // ----- rules -------------------------------------------------------------
    match /users/{userId} {
      // The user document itself is never written by the app.
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;

      match /interactions/{interactionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if (isOwner(userId) || isAdmin())
          && isValidInteraction(request.resource.data, userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Wellness points, emotional stats, and happiness index records
      match /wellness/{wellnessDocId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Discover Me historical snapshots
      match /discover_snapshots/{snapshotId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Outbound notification endpoints. These documents hold webhook URLs and
      // signing secrets - bearer credentials that must never reach a browser.
      // Only the Admin SDK touches them (it bypasses rules); clients go through
      // the authenticated /api/webhooks routes, which return a masked preview.
      match /webhooks/{webhookId} {
        allow read, write: if false;
      }
    }

    // Role-based access control roles table
    match /roles/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Shared reflection access control
    match /shares/{shareId} {
      allow get: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.targetEmail == request.auth.token.email ||
        resource.data.targetUserId == request.auth.uid ||
        isAdmin()
      );
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && isValidShare(request.resource.data);
      allow update: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || isAdmin())
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.permission in ['viewer', 'editor'];
      allow delete: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Everything else is denied by default (no recursive wildcard).
  }
}
