# ==============================================================================
# Reflections & Journal - Environment Variables
# ------------------------------------------------------------------------------
# Local dev:  copy this file to `.env` and fill in values.
# Cloud Run:  set these as service env vars; mount API keys from Secret Manager
#             (never bake real secrets into the image or commit them).
# `.env` is gitignored - only `.env.example` is tracked.
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
# Cloud Run injects PORT and expects the container to listen on it (default 8080).
# Only set this locally. server.ts falls back to 8080 when unset.
PORT=3000

# ---- DO NOT put NODE_ENV in this file. ----
# Vite reads NODE_ENV out of .env files, so `NODE_ENV=development` here makes
# `npm run build` bundle React's DEVELOPMENT build into the production client
# (~315 kB of extra code plus dev-only warnings). `vite build` is already a
# production build; `npm run dev` is already development.
#
# The server reads NODE_ENV to decide between Vite middleware and static dist/,
# and to hide internal error detail. Set it as a REAL environment variable on
# the platform, never here:
#   Cloud Run:  gcloud run deploy ... --set-env-vars NODE_ENV=production
#   Local prod smoke test (bash):  NODE_ENV=production npm start

# ------------------------------------------------------------------------------
# Gemini AI  (server-side only - never exposed to the browser)
# Used by POST /api/reflect and the Gemini tier of POST /api/reverse-geocode.
# Cloud Run:  --set-secrets GEMINI_API_KEY=GEMINI_API_KEY:latest
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Google Maps Platform
# ------------------------------------------------------------------------------
# SERVER key - used only by the /api/reverse-geocode proxy (Geocoding API).
# Give it:  API restriction = Geocoding API only.
# Do NOT reuse the browser key here: HTTP-referrer-restricted keys fail on
# server-to-server calls (no referrer) and trip the proxy's 15-min backoff.
GOOGLE_MAPS_API_KEY=

# BROWSER key - compiled into the client bundle (Maps JavaScript API + Places).
# Vite only exposes VITE_-prefixed vars to client code. This key is visible to
# end users, so it MUST be locked down in Google Cloud Console:
#   - API restriction: "Maps JavaScript API" + "Places API (New)" only
#   - Application restriction: HTTP referrers =
#       https://<service>-<hash>-<region>.a.run.app/*
#       http://localhost:*      (dev only - omit on the production key)
VITE_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# Firebase Admin  (server-side ID-token verification on /api/*)
# ------------------------------------------------------------------------------
# server.ts verifies the caller's Firebase ID token before calling Gemini/Maps.
# Cloud Run:  nothing to set - the runtime service account supplies Application
#             Default Credentials and the project id is auto-detected.
# Local dev:  run `gcloud auth application-default login` once, OR point the
#             line below at a service-account JSON key file.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# GCP project id - auto-detected on Cloud Run; set it if the Admin SDK can't
# resolve it locally.
GOOGLE_CLOUD_PROJECT=gen-lang-client-0708717566

# ------------------------------------------------------------------------------
# App metadata
# ------------------------------------------------------------------------------
# Public base URL of the deployed service (self-referential links, OAuth origin).
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Firebase web config
# ------------------------------------------------------------------------------
# The client Firebase config lives in firebase-applet-config.json (committed).
# apiKey / authDomain / projectId there are public by design for a web app;
# access is gated by Firestore security rules + Firebase Auth "Authorized
# domains" - add your Cloud Run domain there before going live.
